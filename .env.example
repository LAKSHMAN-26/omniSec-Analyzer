# CyberSentinel AI - Environment Variable Template
# Copy this file to server/.env and fill in your values
# NEVER commit the actual .env file to git!

# Backend server port (default: 5000)
PORT=5000

# Environment mode (development or production)
NODE_ENV=development

# Frontend origin for CORS (adjust if using a different port or host)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file path (relative to server/ directory)
DATABASE_PATH=./cybersentinel.db

# Optional: Real IP geolocation API key from https://ipapi.co/
# Leave blank to use built-in demo data (works fine for hackathon)
GEO_API_KEY=

# Optional: Geolocation provider URL (default: ipapi.co)
# GEO_PROVIDER_URL=https://ipapi.co/{ip}/json/
